{
  "family": "kata-frontend-qa",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "networkMode": "awsvpc",
  "taskRoleArn": "arn:aws:iam::YOUR_AWS_ACCOUNT_ID:role/kata-frontend-ecs-task-role",
  "executionRoleArn": "arn:aws:iam::YOUR_AWS_ACCOUNT_ID:role/kata-frontend-ecs-execution-role",
  "containerDefinitions": [
    {
      "name": "kata-frontend",
      "image": "${image_url}",
      "essential": true,
      "cpu": 128,
      "memory": 512,
      "memoryReservation": 256,
      "portMappings": [
        {
          "containerPort": 80,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "ENVIRONMENT",
          "value": "qa"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/aws/ecs/kata-frontend-qa",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs",
          "mode": "non-blocking",
          "max-buffer-size": "25m"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget --no-verbose --tries=1 --spider http://localhost/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      }
    }
  ]
}
